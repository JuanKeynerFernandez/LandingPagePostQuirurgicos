---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const lines = [
  { d: 'M-20 80C60 30 120 150 200 110S360 50 430 100', node: [200, 110], opacity: 0.55 },
  { d: 'M-20 180C80 140 200 260 290 210S400 160 430 190', node: [290, 210], opacity: 0.35 },
  { d: 'M-20 290C50 250 110 340 170 310S330 250 430 300', node: [170, 310], opacity: 0.6 },
  { d: 'M-20 380C90 340 190 440 300 400S400 360 430 390', node: [300, 400], opacity: 0.35 },
  { d: 'M-20 460C70 430 150 500 230 470S380 440 430 470', node: [230, 470], opacity: 0.5 },
];
---

<svg
  class:list={['flow-art', className]}
  viewBox="0 0 400 500"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  {
    lines.map(({ d, node, opacity }) => (
      <g opacity={opacity}>
        <path d={d} fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" />
        <circle cx={node[0]} cy={node[1]} r="6" fill="#fff" />
      </g>
    ))
  }
</svg>

<style>
  .flow-art {
    width: 100%;
    height: 100%;
  }
</style>
