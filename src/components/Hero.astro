---
import { Image } from 'astro:assets';
import { course } from '../data/course';
import { findImage } from '../lib/images';
import { emphasize } from '../lib/text';
import FlowArt from './ui/FlowArt.astro';
import Icon from './ui/Icon.astro';
import WhatsAppButton from './ui/WhatsAppButton.astro';

const { hero } = course;
const image = findImage(hero.image);
---

<section id="inicio" class="hero" aria-labelledby="hero-titulo" data-hide-sticky>
  <div class="container hero__grid">
    <div class="hero__content">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-titulo" class="hero__title" set:html={emphasize(hero.title)} />
      <p class="hero__lead">{hero.lead}</p>

      <div class="hero__actions">
        <WhatsAppButton intent="info" placement="hero" size="lg">{hero.cta}</WhatsAppButton>
        <a class="hero__link" href="#modulos">
          {hero.secondaryCta}
          <Icon name="arrow-down" size={18} />
        </a>
      </div>

      <ul class="hero__highlights">
        {
          hero.highlights.map((item) => (
            <li>
              <span class="hero__check">
                <Icon name="check" size={14} />
              </span>
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__visual">
      <div class="hero__arch">
        {
          image ? (
            <Image
              src={image}
              alt={hero.imageAlt}
              widths={[360, 540, 720, 900]}
              sizes="(min-width: 960px) 440px, 82vw"
              class="hero__photo"
              priority
            />
          ) : (
            <FlowArt />
          )
        }
      </div>
      <p class="hero__quote">“{hero.quote}”</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.25rem, 6vw, 5rem) var(--section-space);
    background:
      radial-gradient(60rem 32rem at 100% 0%, var(--aqua-100), transparent 60%),
      radial-gradient(40rem 28rem at 0% 100%, var(--aqua-50), transparent 70%),
      var(--surface);
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  .hero__content {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  .hero__title {
    font-size: clamp(2.15rem, 7.6vw, 3.9rem);
  }

  .hero__title :global(em) {
    padding-inline: 0.05em;
    background: linear-gradient(transparent 64%, var(--aqua-200) 64%);
  }

  .hero__lead {
    max-width: 34rem;
    font-size: clamp(1.0625rem, 2.6vw, 1.25rem);
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1rem;
    width: 100%;
    margin-top: 0.5rem;
  }

  .hero__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    font-weight: 700;
    color: var(--aqua-700);
    text-decoration: none;
  }

  .hero__link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hero__highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.25rem;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .hero__highlights li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero__check {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--aqua-100);
    color: var(--aqua-700);
  }

  .hero__visual {
    position: relative;
    width: min(100%, 22rem);
    margin-inline: auto;
  }

  .hero__arch {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 50% 50% var(--radius-lg) var(--radius-lg) / 40% 40% var(--radius-lg) var(--radius-lg);
    background: linear-gradient(160deg, var(--aqua-300), var(--aqua-700));
    box-shadow: var(--shadow);
  }

  .hero__arch :global(.hero__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__quote {
    position: absolute;
    bottom: 1.5rem;
    left: -0.75rem;
    max-width: 14rem;
    padding: 0.9rem 1.15rem;
    border-radius: var(--radius);
    background: #fff;
    box-shadow: var(--shadow);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-style: italic;
    font-weight: 600;
    line-height: 1.3;
    color: var(--aqua-900);
  }

  @media (min-width: 560px) {
    .hero__actions {
      flex-direction: row;
      align-items: center;
      width: auto;
    }
  }

  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: 1.15fr 0.85fr;
    }

    .hero__visual {
      width: min(100%, 27rem);
    }

    .hero__quote {
      left: -2.5rem;
      max-width: 16rem;
      font-size: 1.25rem;
    }
  }
</style>
