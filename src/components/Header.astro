---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { findImage } from '../lib/images';
import BrandMark from './ui/BrandMark.astro';
import WhatsAppButton from './ui/WhatsAppButton.astro';

const logo = findImage(site.logo);
---

<a class="skip-link" href="#contenido">Saltar al contenido</a>

<header class="header">
  <div class="container header__bar">
    <a class="header__brand" href="/" aria-label={`${site.name}, ir al inicio`}>
      {
        logo ? (
          <Image src={logo} alt={site.name} height={88} class="header__logo" loading="eager" />
        ) : (
          <>
            <BrandMark />
            <span class="header__name">{site.name}</span>
          </>
        )
      }
    </a>
    <WhatsAppButton intent="info" placement="header" size="sm">WhatsApp</WhatsAppButton>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--line);
    background: rgb(255 255 255 / 0.92);
  }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
  }

  .header__name {
    max-width: 9rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--aqua-900);
  }

  .header__brand :global(.header__logo) {
    width: auto;
    height: 2.75rem;
  }

  @media (min-width: 900px) {
    .header {
      position: sticky;
      top: 0;
      z-index: 40;
      backdrop-filter: blur(12px);
    }

    .header__name {
      max-width: none;
      font-size: 1.125rem;
    }
  }
</style>
