---
import { course } from '../data/course';
import Icon from './ui/Icon.astro';
import Section from './ui/Section.astro';

const { audience } = course;

const cards = [
  { ...audience.for, icon: 'check', modifier: 'yes' },
  { ...audience.notFor, icon: 'x', modifier: 'no' },
] as const;
---

<Section id="para-quien" tone="tint" eyebrow={audience.eyebrow} title={audience.title}>
  <div class="audience">
    {
      cards.map((card) => (
        <article class:list={['audience__card', `audience__card--${card.modifier}`]}>
          <h3 class="audience__title">{card.title}</h3>
          <ul class="audience__list">
            {card.items.map((item) => (
              <li>
                <span class="audience__mark">
                  <Icon name={card.icon} size={14} />
                </span>
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <p class="audience__note">
    <Icon name="info" size={22} class="audience__note-icon" />
    <span>{audience.patientNote}</span>
  </p>
</Section>

<style>
  .audience {
    display: grid;
    gap: 1.25rem;
  }

  .audience__card {
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: #fff;
  }

  .audience__card--yes {
    border-top: 5px solid var(--aqua-500);
    box-shadow: var(--shadow-sm);
  }

  .audience__title {
    margin-bottom: 1.25rem;
    font-size: 1.5rem;
  }

  .audience__list {
    display: grid;
    gap: 0.85rem;
    padding: 0;
    list-style: none;
  }

  .audience__list li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .audience__mark {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.1rem;
    flex-shrink: 0;
    border-radius: 50%;
  }

  .audience__card--yes .audience__mark {
    background: var(--aqua-100);
    color: var(--aqua-700);
  }

  .audience__card--no .audience__mark {
    background: #f6e3dd;
    color: var(--negative);
  }

  .audience__note {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    max-width: 48rem;
    margin: 2rem auto 0;
    padding: 1rem 1.25rem;
    border: 1px dashed var(--aqua-400);
    border-radius: var(--radius);
    font-size: 0.975rem;
    color: var(--ink-soft);
  }

  .audience__note :global(.audience__note-icon) {
    color: var(--aqua-700);
  }

  @media (min-width: 820px) {
    .audience {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: start;
    }
  }
</style>
