---
import { course } from '../data/course';
import Icon from './ui/Icon.astro';
import Section from './ui/Section.astro';
import WhatsAppButton from './ui/WhatsAppButton.astro';

const { faq } = course;
---

<Section id="preguntas" tone="tint" eyebrow={faq.eyebrow} title={faq.title} narrow>
  <div class="faq">
    {
      faq.items.map((item) => (
        <details class="faq__item">
          <summary class="faq__question">
            <span>{item.question}</span>
            <span class="faq__toggle">
              <Icon name="plus" size={18} />
            </span>
          </summary>
          <p class="faq__answer">{item.answer}</p>
        </details>
      ))
    }
  </div>

  <div class="faq__more">
    <p>¿Tienes otra pregunta?</p>
    <WhatsAppButton intent="question" placement="preguntas" variant="outline">
      Escríbenos por WhatsApp
    </WhatsAppButton>
  </div>
</Section>

<style>
  .faq {
    display: grid;
    gap: 0.75rem;
  }

  .faq__item {
    border-radius: var(--radius);
    background: #fff;
    box-shadow: var(--shadow-sm);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .faq__toggle {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--aqua-50);
    color: var(--aqua-700);
    transition: transform 0.25s ease;
  }

  .faq__item[open] .faq__toggle {
    transform: rotate(45deg);
  }

  .faq__answer {
    padding: 0 1.25rem 1.25rem;
    color: var(--ink-soft);
  }

  .faq__more {
    display: grid;
    justify-items: center;
    gap: 0.85rem;
    margin-top: 2.5rem;
    font-weight: 600;
    text-align: center;
  }
</style>
