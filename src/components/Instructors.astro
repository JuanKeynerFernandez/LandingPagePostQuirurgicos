---
import { Image } from 'astro:assets';
import { course } from '../data/course';
import { findImage } from '../lib/images';
import Icon from './ui/Icon.astro';
import Section from './ui/Section.astro';

const { instructors } = course;

const people = instructors.people.map((person) => ({
  ...person,
  image: findImage(person.photo),
}));
---

<Section
  id="instructora"
  eyebrow={instructors.eyebrow}
  title={instructors.title}
  intro={instructors.intro}
>
  <div class="people">
    {
      people.map((person) => (
        <article class="person">
          <div class="person__photo">
            {person.image ? (
              <Image
                src={person.image}
                alt={person.name ?? 'Instructora del curso'}
                widths={[320, 480, 640]}
                sizes="(min-width: 860px) 360px, 80vw"
              />
            ) : (
              <span class="pending">Pendiente: foto de la instructora</span>
            )}
          </div>

          <div class="person__content">
            <header class="person__header">
              <h3 class="person__name">
                {person.name ?? <span class="pending">Pendiente: nombre de la instructora</span>}
              </h3>
              <p class="person__role">
                {person.role ?? <span class="pending">Pendiente: profesión y experiencia</span>}
              </p>
            </header>

            {person.highlights.length > 0 && (
              <ul class="person__highlights">
                {person.highlights.map((item) => (
                  <li>
                    <span class="person__check">
                      <Icon name="check" size={14} />
                    </span>
                    {item}
                  </li>
                ))}
              </ul>
            )}

            <div class="person__bio">
              {person.bio.length > 0 ? (
                person.bio.map((paragraph) => <p>{paragraph}</p>)
              ) : (
                <p>
                  <span class="pending">Pendiente: biografía corta</span>
                </p>
              )}
            </div>

            {person.quote && (
              <blockquote class="person__quote">
                <p>“{person.quote}”</p>
              </blockquote>
            )}
          </div>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .people {
    display: grid;
    gap: clamp(3rem, 8vw, 5rem);
  }

  .person {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .person__photo {
    display: grid;
    place-items: center;
    width: min(100%, 20rem);
    aspect-ratio: 4 / 5;
    margin-inline: auto;
    overflow: hidden;
    border-radius: 50% 50% var(--radius-lg) var(--radius-lg) / 40% 40% var(--radius-lg) var(--radius-lg);
    background: linear-gradient(160deg, var(--aqua-100), var(--aqua-300));
    box-shadow: var(--shadow);
    text-align: center;
  }

  .person__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .person__photo .pending {
    margin: 1.5rem;
  }

  .person__content {
    display: grid;
    gap: 1.5rem;
  }

  .person__header {
    display: grid;
    gap: 0.5rem;
  }

  .person__name {
    font-size: clamp(1.85rem, 5vw, 2.4rem);
  }

  .person__role {
    font-weight: 700;
    line-height: 1.4;
    color: var(--aqua-700);
  }

  .person__highlights {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--aqua-50);
    list-style: none;
    font-weight: 600;
  }

  .person__highlights li {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
  }

  .person__check {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.05rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--aqua-700);
    color: #fff;
  }

  .person__bio {
    display: grid;
    gap: 0.9rem;
    color: var(--ink-soft);
  }

  .person__bio p:last-child {
    font-weight: 600;
    color: var(--aqua-900);
  }

  .person__quote {
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 4px solid var(--aqua-300);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 3.4vw, 1.45rem);
    font-style: italic;
    font-weight: 600;
    line-height: 1.35;
    color: var(--aqua-900);
  }

  @media (min-width: 860px) {
    .person {
      grid-template-columns: 22rem 1fr;
      gap: 4rem;
    }

    .person__photo {
      position: sticky;
      top: 6rem;
      width: 100%;
    }
  }
</style>
