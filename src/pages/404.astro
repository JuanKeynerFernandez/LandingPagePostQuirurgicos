---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import WhatsAppButton from '../components/ui/WhatsAppButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title={`Página no encontrada | ${site.name}`} noindex>
  <Header />
  <main id="contenido" class="not-found">
    <div class="container container--narrow">
      <p class="eyebrow">Error 404</p>
      <h1>Esta página no existe</h1>
      <p>Puede que el enlace esté mal escrito o que la página se haya movido.</p>
      <div class="not-found__actions">
        <a class="btn btn--outline" href="/">Ir al inicio</a>
        <WhatsAppButton intent="question" placement="404">Escríbenos</WhatsAppButton>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(4rem, 12vw, 8rem);
    text-align: center;
  }

  .not-found .container {
    display: grid;
    justify-items: center;
    gap: 1rem;
  }

  .not-found h1 {
    font-size: clamp(2rem, 6vw, 3rem);
  }

  .not-found p {
    color: var(--ink-soft);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>
